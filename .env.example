# ---------------------------------------------------------------------------
# Freebuff portfolio — environment variables
# Copy to .env (local) and configure the same values in your host (Vercel etc.)
# ---------------------------------------------------------------------------

# --- Data store (Upstash Redis) — REQUIRED for production persistence ---
# Without these, the app falls back to in-memory storage (dev only, lost on restart).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Admin moderation ---
# Passcode for /admin (feedback approval + inbox). Set a LONG random value.
# Leave unset and the admin panel is effectively disabled (all admin APIs return 401).
ADMIN_PASSCODE=

# --- Support / donations ---
# UPI payee. The code defaults to the owner's UPI ID (7082739587@jupiteraxis);
# override here to change it per environment without touching code.
SUPPORT_UPI_ID=7082739587@jupiteraxis
# Display name shown in the UPI app.
SUPPORT_UPI_NAME=Rahul Singh Shekhawat
# Prefix stamped on every payment reference note (helps you identify portfolio donations).
SUPPORT_UPI_REF_PREFIX=PORTFOLIO
# Optional Polar (polar.sh) hosted checkout link for card / international donations.
# Create a donation checkout in your Polar dashboard and paste the link here.
POLAR_CHECKOUT_URL=

# --- Email notifications for new contact messages (optional, recommended) ---
# Option 1 — Gmail SMTP (no third party). Enable 2-Step Verification on your
# Google account, create an App Password (Google → Security → App passwords),
# then set:
SMTP_USER=rahulsinghpilani7@gmail.com
SMTP_PASS=
# (Optional) defaults to smtp.gmail.com:465 — change only if not using Gmail.
SMTP_HOST=
SMTP_PORT=
# Option 2 — Resend API fallback (free at https://resend.com): set RESEND_API_KEY
# and it is used when SMTP creds are absent.
RESEND_API_KEY=
# Optional override: the only inbox that receives owner notifications
# (messages + inquiries). Defaults to rahulsinghpilani7@gmail.com.
CONTACT_EMAIL_TO=rahulsinghpilani7@gmail.com
# Optional sender address (e.g. hello@rahulshekhawat.dev). With SMTP it defaults
# to SMTP_USER; with Resend it defaults to their test sender.
CONTACT_EMAIL_FROM=

# --- SEO / metadata ---
# Canonical domain, e.g. https://rahulshekhawat.dev
NEXT_PUBLIC_SITE_URL=
# Google Search Console verification token (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Security ---
# Secret salt used to hash visitor IPs before storage. Generate once and keep secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=
